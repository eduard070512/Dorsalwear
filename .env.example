# Contraseña del panel /admin (también firma la sesión).
ADMIN_PASSWORD=
# Postgres (Neon, Vercel Postgres, etc.). Sin esto la tienda funciona y los pedidos llegan solo por WhatsApp.
DATABASE_URL=
# Datos para pago por transferencia (se muestran al confirmar el pedido).
BANCO_NOMBRE=
BANCO_TITULAR=
BANCO_CLABE=
# Dominio público (para SEO / sitemap).
NEXT_PUBLIC_SITE_URL=https://dorsalwear.com

# --- Envíos con Skydrop (listo, apagado) ---
# Ponerlo en "true" activa la cotización automática en el carrito y el botón "Generar guía" en /admin.
SKYDROP_ENABLED=false
SKYDROP_API_KEY=
SKYDROP_API_URL=https://api.skydrop.com.mx/v1
# Dirección de origen (desde donde se envía).
SKYDROP_ORIGEN_CP=28000
SKYDROP_ORIGEN_NOMBRE=Dorsalwear
SKYDROP_ORIGEN_TELEFONO=3121712462
SKYDROP_ORIGEN_CALLE=
SKYDROP_ORIGEN_COLONIA=
SKYDROP_ORIGEN_CIUDAD=Colima
SKYDROP_ORIGEN_ESTADO=Colima
